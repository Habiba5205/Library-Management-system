@model IEnumerable<Lib_System.Models.User>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

@if (User.IsInRole("Manager"))
{
<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New User</a>
</p>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Username</th>
            <th>Role</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.Username</td>
            <td>@(item.Role?.RoleName ?? "-")</td>
            <td>
                <span class="badge bg-@(item.Status == "Active" ? "success" : "secondary")">
                    @item.Status
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Manager"))
                {
                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
