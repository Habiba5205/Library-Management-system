@model Lib_System.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<h3 class="text-danger">Are you sure you want to delete this user?</h3>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.SelectMany(ms => ms.Value?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>()))
        {
            <p class="mb-0">@error.ErrorMessage</p>
        }
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Role</dt>
        <dd class="col-sm-9">@(Model.Role?.RoleName ?? "-")</dd>
    </dl>
</div>

@{
    bool hasBorrowings = Model.Borrowings != null && Model.Borrowings.Any();
    var managedBookCount = Model.ManagedBooks?.Count ?? 0;
    bool hasManagedBooks = managedBookCount > 0;
}

@if (hasManagedBooks)
{
    <div class="alert alert-warning">
        <strong>Heads up:</strong> this user manages @managedBookCount book(s).
        Deleting them will unassign those books (the books themselves are not deleted).
    </div>
}

<form asp-action="Delete">
    <input type="hidden" asp-for="UserId" />
    <input type="submit" value="Delete" class="btn btn-danger" disabled="@(hasBorrowings ? "disabled" : null)" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@if (hasBorrowings)
{
    <p class="text-muted mt-2">
        <em>Delete is disabled because this user has borrowing history.</em>
    </p>
}
