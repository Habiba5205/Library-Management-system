@model IEnumerable<Lib_System.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="page-header">
    <h1>@(User.IsInRole("Member") ? "My Payments" : "Payments")</h1>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" aria-label="Payment status">
            <option value="">All statuses</option>
            <option value="Paid" selected="@(ViewBag.Status == "Paid")">Paid</option>
            <option value="Pending" selected="@(ViewBag.Status == "Pending")">Pending</option>
            <option value="Failed" selected="@(ViewBag.Status == "Failed")">Failed</option>
            <option value="Refunded" selected="@(ViewBag.Status == "Refunded")">Refunded</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Borrowing</th>
            <th>Book</th>
            <th>Member</th>
            <th>Amount</th>
            <th>Payment Date</th>
            <th>Method</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>#@item.BorrowingId</td>
            <td>@(item.Borrowing?.Book?.Title ?? "-")</td>
            <td>@(item.Borrowing?.User?.Name ?? "-")</td>
            <td>@item.Amount.ToUsd()</td>
            <td>@item.PaymentDate.ToString("yyyy-MM-dd")</td>
            <td>@item.PaymentMethod</td>
            <td>
                <span class="badge bg-@(item.Status == "Paid" ? "success" : "secondary")">
                    @item.Status
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Manager") && item.PaymentMethod == "Cash" && item.Status == "Pending" && item.Borrowing?.Status == "Reserved")
                {
                    <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-warning">Review Cash Payment</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
