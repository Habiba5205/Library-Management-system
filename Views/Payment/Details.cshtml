@model Lib_System.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<h1>Payment Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Borrowing</dt>
        <dd class="col-sm-9">#@Model.BorrowingId</dd>

        <dt class="col-sm-3">Book</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.Book?.Title ?? "-")</dd>

        <dt class="col-sm-3">Member</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.User?.Name ?? "-")</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-3">Payment Date</dt>
        <dd class="col-sm-9">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Method</dt>
        <dd class="col-sm-9">@Model.PaymentMethod</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge bg-@(Model.Status == "Paid" ? "success" : "secondary")">
                @Model.Status
            </span>
        </dd>

        <dt class="col-sm-3">Transaction Reference</dt>
        <dd class="col-sm-9">@(Model.TransactionReference ?? "-")</dd>
    </dl>
</div>

<div class="mt-3">
    @if (User.IsInRole("Manager"))
    {
    <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
