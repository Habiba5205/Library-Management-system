@model Lib_System.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<h1>Payment Details</h1>
@if (TempData["PaymentMessage"] is string message)
{
    <p class="alert alert-info">@message</p>
}
@if (Model.Status == "Pending" && Model.PaymentMethod == "Cash" && Model.Borrowing?.Status == "Reserved")
{
    <p class="alert alert-info">Pay the manager in person before @Model.Borrowing.ReservationExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC to confirm this borrowing.</p>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Borrowing</dt>
        <dd class="col-sm-9">#@Model.BorrowingId</dd>

        <dt class="col-sm-3">Book</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.Book?.Title ?? "-")</dd>

        <dt class="col-sm-3">Member</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.User?.Name ?? "-")</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToUsd()</dd>

        <dt class="col-sm-3">Payment Date</dt>
        <dd class="col-sm-9">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Method</dt>
        <dd class="col-sm-9">@Model.PaymentMethod</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge bg-@(Model.Status == "Paid" ? "success" : "secondary")">
                @Model.Status
            </span>
        </dd>

        <dt class="col-sm-3">Transaction Reference</dt>
        <dd class="col-sm-9">@(Model.TransactionReference ?? "-")</dd>
    </dl>
</div>

<div class="mt-3">
    @if (User.IsInRole("Manager") && Model.PaymentMethod == "Cash" && Model.Status == "Pending" && Model.Borrowing?.Status == "Reserved")
    {
        <form asp-action="ConfirmCash" method="post" class="mb-3">
            <input type="hidden" name="id" value="@Model.PaymentId" />
            <button type="submit" class="btn btn-success">Confirm Cash Received</button>
        </form>
    }
    @if (User.IsInRole("Member") && Model.PaymentMethod == "Card" && Model.Status == "Pending")
    {
        <a asp-action="Checkout" asp-route-id="@Model.PaymentId" class="btn btn-primary">Pay with Card (Stripe)</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
