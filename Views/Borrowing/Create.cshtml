@model Lib_System.ViewModels.BorrowingFormViewModel

@{
    ViewData["Title"] = "Borrow Book";
}

<h1>Borrow Book</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="BookId" class="control-label"></label>
                <select asp-for="BookId" asp-items="Model.Books" class="form-select">
                    <option value="">Select a book</option>
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="UserId" />

            <div class="form-group mb-3">
                <span class="form-label">Loan Duration</span>
                <p class="form-control-plaintext">14 days</p>
            </div>

            <div class="form-group mb-3">
                <fieldset>
                    <legend class="form-label">Payment method</legend>
                    <div class="payment-choices">
                        <label class="payment-choice">
                            <input asp-for="PaymentMethod" id="payment-card" type="radio" value="Card" />
                            <i data-lucide="credit-card" aria-hidden="true"></i><span>Card (Stripe)</span>
                        </label>
                        <label class="payment-choice">
                            <input asp-for="PaymentMethod" id="payment-cash" type="radio" value="Cash" />
                            <i data-lucide="banknote" aria-hidden="true"></i><span>Cash</span>
                        </label>
                    </div>
                </fieldset>
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Borrow" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
