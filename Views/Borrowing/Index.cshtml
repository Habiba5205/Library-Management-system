@model IEnumerable<Lib_System.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowings";
    var member = User.IsInRole("Member");
}

<div class="page-header">
<h1>@(member ? "My Borrowings" : "Borrowings")</h1>

@if (member)
{
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="book-plus" aria-hidden="true"></i>Borrow Book</a>
}
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select" aria-label="Borrowing status">
            <option value="">All statuses</option>
            <option value="Borrowed" selected="@(ViewBag.Status == "Borrowed")">Borrowed</option>
            <option value="Reserved" selected="@(ViewBag.Status == "Reserved")">Reserved</option>
            <option value="Failed" selected="@(ViewBag.Status == "Failed")">Failed</option>
            <option value="Early Return Requested" selected="@(ViewBag.Status == "Early Return Requested")">Early Return Requested</option>
            <option value="Returned" selected="@(ViewBag.Status == "Returned")">Returned</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (member)
{
    <div class="borrowing-cards">
    @foreach (var item in Model)
    {
        var payment = item.Payments.OrderByDescending(p => p.PaymentId).FirstOrDefault();
        var isOverdue = item.Status == "Borrowed" && item.DueDate.Date < DateTime.Today;
        <div class="borrowing-card @(isOverdue ? "borrowing-card-overdue" : "")">
            <div class="borrowing-card-cover">
                @if (item.Book != null) { <partial name="_CoverImage" model="item.Book" /> }
            </div>
            <div class="borrowing-card-body">
                <div class="borrowing-card-top">
                    <h2>@(item.Book?.Title ?? "-")</h2>
                    <span class="badge bg-@(item.Status == "Failed" ? "danger" : item.Status == "Returned" ? "success" : isOverdue ? "danger" : item.Status == "Reserved" ? "info" : "warning")">
                        @(isOverdue ? "Overdue" : item.Status)
                    </span>
                </div>
                <p class="borrowing-card-dates">
                    @if (item.Status is "Reserved" or "Failed")
                    {
                        <span>Expires @item.ReservationExpiresAtUtc?.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span>Borrowed @item.BorrowDate.ToString("yyyy-MM-dd")</span>
                        <span>Due @item.DueDate.ToString("yyyy-MM-dd")</span>
                    }
                </p>
                @if (payment != null)
                {
                    <p class="borrowing-card-payment">
                        <i data-lucide="credit-card" aria-hidden="true"></i>
                        @payment.PaymentMethod
                        <span class="badge bg-@(payment.Status == "Paid" ? "success" : payment.Status == "Failed" ? "danger" : "warning")">@payment.Status</span>
                    </p>
                }
                <div class="borrowing-card-actions">
                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-action="Details" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-outline-secondary">Details</a>
                    }
                    @if (item.Status == "Borrowed")
                    {
                        var isEarlyReturn = DateTime.Today < item.DueDate.Date;
                        <a asp-action="Return" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-success">
                            @(isEarlyReturn ? "Request Early Return" : "Return")
                        </a>
                    }
                    else if (item.Status == "Reserved" && payment?.PaymentMethod == "Card" && payment.Status == "Pending")
                    {
                        <a asp-controller="Payment" asp-action="Checkout" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-primary">Pay Now</a>
                    }
                </div>
            </div>
        </div>
    }
    </div>
    @if (!Model.Any())
    {
        <p class="empty-state">No borrowings yet.</p>
    }
}
else
{
<table class="table table-striped table-bordered borrowings-table">
    <thead>
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Dates</th>
            <th>Payment</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var payment = item.Payments.OrderByDescending(p => p.PaymentId).FirstOrDefault();
            <tr>
                <td>
                    <strong>@(item.User?.Name ?? "-")</strong>
                    <small>@(item.User?.Email ?? "-")</small>
                </td>
                <td>@(item.Book?.Title ?? "-")</td>
                <td>
                    @if (item.Status is "Reserved" or "Failed")
                    {
                        <span class="text-warning">Expires @item.ReservationExpiresAtUtc?.ToLocalTime().ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span>Borrowed @item.BorrowDate.ToString("yyyy-MM-dd")</span>
                        <small>Due @item.DueDate.ToString("yyyy-MM-dd")</small>
                    }
                </td>
                <td>
                    @if (payment != null)
                    {
                        <span>@payment.PaymentMethod</span>
                        <span class="badge bg-@(payment.Status == "Paid" ? "success" : payment.Status == "Failed" ? "danger" : "warning")">@payment.Status</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>
                <td>
                    <span class="badge bg-@(item.Status == "Failed" ? "danger" : item.Status == "Returned" ? "success" : item.Status == "Reserved" ? "info" : "warning")">
                        @item.Status
                    </span>
                </td>
                <td>
                    @if (User.IsInRole("Manager"))
                    {
                        <a asp-action="Details" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-info">Details</a>
                    }
                    @if ((item.Status is "Borrowed" or "Early Return Requested") && User.IsInRole("Manager"))
                    {
                        <a asp-action="Return" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-success">Return</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
}
