@model IEnumerable<Lib_System.Models.Borrowing>

@{
    ViewData["Title"] = "Borrowings";
}

<h1>Borrowings</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Borrow Book</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <select name="status" class="form-select">
            <option value="">-- All Statuses --</option>
            <option value="Borrowed" selected="@(ViewBag.Status == "Borrowed")">Borrowed</option>
            <option value="Returned" selected="@(ViewBag.Status == "Returned")">Returned</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@(item.Book?.Title ?? "-")</td>
            <td>@(item.User?.Name ?? "-")</td>
            <td>@item.BorrowDate.ToString("yyyy-MM-dd")</td>
            <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
            <td>@(item.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
            <td>
                <span class="badge bg-@(item.Status == "Borrowed" ? "warning" : "success")">
                    @item.Status
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-info">Details</a>
                @if (item.Status != "Returned")
                {
                    <a asp-action="Return" asp-route-id="@item.BorrowingId" class="btn btn-sm btn-success">Return</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>

