@model Lib_System.Models.Borrowing

@{
    ViewData["Title"] = "Borrowing Details";
}

<h1>Borrowing Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Book</dt>
        <dd class="col-sm-9">@Model.Book?.Title</dd>

        <dt class="col-sm-3">ISBN</dt>
        <dd class="col-sm-9">@Model.Book?.ISBN</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@(Model.Book?.Category?.Name ?? "-")</dd>

        <dt class="col-sm-3">Author(s)</dt>
        <dd class="col-sm-9">
            @if (Model.Book?.BookAuthors.Any() == true)
            {
                @string.Join(", ", Model.Book.BookAuthors.Select(ba => ba.Author?.Name))
            }
            else
            {
                <em>No authors linked</em>
            }
        </dd>

        <dt class="col-sm-3">Member</dt>
        <dd class="col-sm-9">@Model.User?.Name</dd>

        <dt class="col-sm-3">Borrow Date</dt>
        <dd class="col-sm-9">@(Model.Status is "Reserved" or "Failed" ? "-" : Model.BorrowDate.ToString("yyyy-MM-dd"))</dd>

        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">@(Model.Status is "Reserved" or "Failed" ? "-" : Model.DueDate.ToString("yyyy-MM-dd"))</dd>
        @if (Model.Status == "Reserved")
        {
            <dt class="col-sm-3">Reservation Expires (UTC)</dt>
            <dd class="col-sm-9">@Model.ReservationExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm")</dd>
        }

        <dt class="col-sm-3">Return Date</dt>
        <dd class="col-sm-9">@(Model.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge bg-@(Model.Status == "Borrowed" ? "warning" : Model.Status == "Early Return Requested" ? "info" : "success")">
                @Model.Status
            </span>
        </dd>

        <dt class="col-sm-3">Payment</dt>
        <dd class="col-sm-9">
            @if (Model.Payments.Any())
            {
                <ul class="detail-sublist">
                    @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentId))
                    {
                        <li>
                            <a asp-controller="Payment" asp-action="Details" asp-route-id="@payment.PaymentId">@payment.PaymentMethod - @payment.Amount.ToUsd()</a>
                            <span class="badge bg-@(payment.Status == "Paid" ? "success" : payment.Status == "Failed" ? "danger" : "warning")">@payment.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <em>No payment recorded</em>
            }
        </dd>

        <dt class="col-sm-3">Fines</dt>
        <dd class="col-sm-9">
            @if (Model.Fines.Any())
            {
                <ul class="detail-sublist">
                    @foreach (var fine in Model.Fines.OrderByDescending(f => f.FineId))
                    {
                        <li>
                            <a asp-controller="Fine" asp-action="Details" asp-route-id="@fine.FineId">@fine.Amount.ToUsd() - @fine.Reason</a>
                            <span class="badge bg-@(fine.Status == "Paid" ? "success" : "danger")">@fine.Status</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <em>No fines</em>
            }
        </dd>
    </dl>
</div>

<div class="mt-3">
    @if ((Model.Status is "Borrowed" or "Early Return Requested") && User.IsInRole("Manager"))
    {
        <a asp-action="Return" asp-route-id="@Model.BorrowingId" class="btn btn-success">Return Book</a>
    }
    else if (Model.Status == "Borrowed" && User.IsInRole("Member"))
    {
        var isEarlyReturn = DateTime.Today < Model.DueDate.Date;
        <a asp-action="Return" asp-route-id="@Model.BorrowingId" class="btn btn-success">
            @(isEarlyReturn ? "Request Early Return" : "Return Book")
        </a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
