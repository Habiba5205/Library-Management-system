@model IEnumerable<Lib_System.Models.Book>
<div class="catalog-grid">
@foreach (var book in Model)
{
    <article class="catalog-book" data-category="@book.CategoryId">
        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="book-cover cover-@(book.BookId % 6)" aria-label="View @book.Title">
            <partial name="_CoverImage" model="book" />
            @if (book.CoverImage == null) { <span class="cover-title">@book.Title</span> }
            <span class="badge bg-@(book.AvailabilityStatus == "Available" ? "success" : "secondary")">@book.AvailabilityStatus</span>
        </a>
        <h2>@book.Title</h2>
        <p class="book-author">@string.Join(", ", book.BookAuthors.Select(ba => ba.Author?.Name))</p>
        <p class="book-category">@(book.Category?.Name ?? "-")</p>
        @if (book.AvailabilityStatus == "Available")
        {
            <a asp-controller="Borrowing" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-primary w-100">Borrow</a>
        }
        else
        {
            <button type="button" class="btn btn-secondary w-100" disabled>@book.AvailabilityStatus</button>
        }
    </article>
}
</div>
@if (!Model.Any())
{
    <p class="empty-state">No books found.</p>
}
