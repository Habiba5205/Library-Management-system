@model IEnumerable<Lib_System.Models.Book>
<div class="catalog-grid">
@foreach (var book in Model)
{
    <article class="catalog-book">
        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId" class="book-cover" aria-label="View @book.Title">
            <i data-lucide="book-open" aria-hidden="true"></i>
            <span class="cover-title">@book.Title</span>
            <span class="badge bg-@(book.AvailabilityStatus == "Available" ? "success" : "secondary")">@book.AvailabilityStatus</span>
        </a>
        <h2><a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookId">@book.Title</a></h2>
        <p class="book-author">@string.Join(", ", book.BookAuthors.Select(ba => ba.Author?.Name))</p>
        <p class="book-category">@(book.Category?.Name ?? "-")</p>
        @if (book.AvailabilityStatus == "Available")
        {
            <a asp-controller="Borrowing" asp-action="Create" asp-route-bookId="@book.BookId" class="btn btn-primary btn-sm">Borrow</a>
        }
        else
        {
            <button type="button" class="btn btn-secondary btn-sm" disabled>Unavailable</button>
        }
    </article>
}
</div>
@if (!Model.Any())
{
    <p class="empty-state">No books found.</p>
}
