@model Lib_System.Components.LibraryStatsViewModel

<ul class="auth-stats">
    <li><i data-lucide="library" aria-hidden="true"></i><span><strong>@Model.BookCount</strong> book@(Model.BookCount == 1 ? "" : "s") in the catalog</span></li>
    <li><i data-lucide="users" aria-hidden="true"></i><span><strong>@Model.ActiveMemberCount</strong> active member@(Model.ActiveMemberCount == 1 ? "" : "s")</span></li>
    <li><i data-lucide="shield-check" aria-hidden="true"></i><span>Full borrowing &amp; fine management</span></li>
</ul>
