@model IEnumerable<Lib_System.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="page-header">
<h1>@(User.IsInRole("Member") ? "Browse Books" : "Books")</h1>
@if (User.IsInRole("Manager"))
{
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus" aria-hidden="true"></i>Add Book</a>
}
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewBag.SearchString"
               class="form-control" placeholder="Search title or ISBN" aria-label="Search title or ISBN" />
    </div>
    <div class="col-auto">
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select" aria-label="Category">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="authorId" asp-items="ViewBag.Authors" class="form-select" aria-label="Author">
            <option value="">All authors</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (User.IsInRole("Member"))
{
    <partial name="_BookGrid" model="Model" />
}
else
{
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Book</th>
            <th>Category</th>
            <th>ISBN</th>
            <th>Price</th>
            <th>Availability</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td class="book-row-cell">
                <span class="table-book-cover"><partial name="_CoverImage" model="item" /></span>
                <span>
                    <strong>@item.Title</strong>
                    <small>@string.Join(", ", item.BookAuthors.Select(ba => ba.Author?.Name))</small>
                </span>
            </td>
            <td>@(item.Category?.Name ?? "-")</td>
            <td>@item.ISBN</td>
            <td>@item.Price.ToUsd()</td>
            <td>
                <span class="badge bg-@(item.AvailabilityStatus == "Available" ? "success" : "secondary")">
                    @item.AvailabilityStatus
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Member") && item.AvailabilityStatus == "Available")
                {
                    <a asp-controller="Borrowing" asp-action="Create" asp-route-bookId="@item.BookId" class="btn btn-sm btn-success">Borrow</a>
                }
                @if (User.IsInRole("Manager"))
                {
                <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
}
