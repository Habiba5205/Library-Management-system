@model IEnumerable<Lib_System.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

@if (User.IsInRole("Manager"))
{
<p>
    <a asp-action="Create" class="btn btn-primary">+ Add New Book</a>
</p>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="searchString" value="@ViewBag.SearchString"
               class="form-control" placeholder="Search title or ISBN" />
    </div>
    <div class="col-auto">
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">-- All Categories --</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="authorId" asp-items="ViewBag.Authors" class="form-select">
            <option value="">-- All Authors --</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>ISBN</th>
            <th>Category</th>
            <th>Author(s)</th>
            <th>Price</th>
            <th>Availability</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@item.Title</td>
            <td>@item.ISBN</td>
            <td>@(item.Category?.Name ?? "-")</td>
            <td>@string.Join(", ", item.BookAuthors.Select(ba => ba.Author?.Name))</td>
            <td>@item.Price.ToString("C")</td>
            <td>
                <span class="badge bg-@(item.AvailabilityStatus == "Available" ? "success" : "secondary")">
                    @item.AvailabilityStatus
                </span>
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Member") && item.AvailabilityStatus == "Available")
                {
                    <a asp-controller="Borrowing" asp-action="Create" asp-route-bookId="@item.BookId" class="btn btn-sm btn-success">Borrow</a>
                }
                @if (User.IsInRole("Manager"))
                {
                <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
