@model IEnumerable<Lib_System.Models.Author>

@{
    ViewData["Title"] = "Authors";
}

<div class="page-header">
<h1>Authors</h1>

@if (User.IsInRole("Manager"))
{
    <a asp-action="Create" class="btn btn-primary"><i data-lucide="plus" aria-hidden="true"></i>Add Author</a>
}
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Biography)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Biography)</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.AuthorId" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Manager"))
                {
                <a asp-action="Edit" asp-route-id="@item.AuthorId" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.AuthorId" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
