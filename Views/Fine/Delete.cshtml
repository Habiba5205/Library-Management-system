@model Lib_System.Models.Fine

@{
    ViewData["Title"] = "Delete Fine";
}

<h1>Delete Fine</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this fine?
</div>

<dl class="row">
    <dt class="col-sm-3">Borrowing</dt>
    <dd class="col-sm-9">#@Model.BorrowingId</dd>

    <dt class="col-sm-3">Book</dt>
    <dd class="col-sm-9">@(Model.Borrowing?.Book?.Title ?? "-")</dd>

    <dt class="col-sm-3">Member</dt>
    <dd class="col-sm-9">@(Model.Borrowing?.User?.Name ?? "-")</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

    <dt class="col-sm-3">Fine Date</dt>
    <dd class="col-sm-9">@Model.FineDate.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="FineId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

