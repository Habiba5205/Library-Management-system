@model Lib_System.ViewModels.FineFormViewModel

@{
    ViewData["Title"] = "Edit Fine";
}

<h1>Edit Fine</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <input type="hidden" asp-for="FineId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="BorrowingId" class="control-label"></label>
                <select asp-for="BorrowingId" asp-items="Model.Borrowings" class="form-select" disabled="@Model.IsAutomatic">
                    <option value="">-- Select Borrowing --</option>
                </select>
                <span asp-validation-for="BorrowingId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" readonly="@Model.IsAutomatic" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FineDate" class="control-label"></label>
                <input asp-for="FineDate" class="form-control" readonly="@Model.IsAutomatic" />
                <span asp-validation-for="FineDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reason" class="control-label"></label>
                <input asp-for="Reason" class="form-control" readonly="@Model.IsAutomatic" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Unpaid">Unpaid</option>
                    <option value="Paid">Paid</option>
                    @if (!Model.IsAutomatic)
                    {
                        <option value="Waived">Waived</option>
                    }
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
