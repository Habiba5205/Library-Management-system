@model Lib_System.Models.Fine
@{
    ViewData["Title"] = "Demo Fine Checkout";
}
<h1>Demo Fine Checkout</h1>
<p class="alert alert-warning">Test payment only. No money is charged. Do not enter real card details.</p>
<dl class="row">
    <dt class="col-sm-3">Book</dt>
    <dd class="col-sm-9">@Model.Borrowing?.Book?.Title</dd>
    <dt class="col-sm-3">Fine Amount</dt>
    <dd class="col-sm-9">@Model.PaymentAmount?.ToString("0.00") EGP</dd>
</dl>
@if (Model.Amount != Model.PaymentAmount)
{
    <p class="alert alert-info">The fine has increased to @Model.Amount.ToString("0.00") EGP. Confirm the new amount before paying.</p>
    <a asp-action="Details" asp-route-id="@Model.FineId" class="btn btn-primary">Review Updated Fine</a>
}
else
{
    <form asp-action="DemoResult" method="post" class="d-flex flex-wrap gap-2">
        <input type="hidden" name="id" value="@Model.FineId" />
        <input type="hidden" name="attemptId" value="@Model.PaymentAttemptId" />
        <input type="hidden" name="amount" value="@Model.PaymentAmount" />
        <button name="outcome" value="success" class="btn btn-success">Simulate Successful Payment</button>
        <button name="outcome" value="failure" class="btn btn-danger">Simulate Failed Payment</button>
        <button name="outcome" value="cancel" class="btn btn-secondary">Cancel Payment</button>
    </form>
}
