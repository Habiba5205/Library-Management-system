@model Lib_System.Models.Fine

@{
    ViewData["Title"] = "Fine Details";
}

<h1>Fine Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Borrowing</dt>
        <dd class="col-sm-9">#@Model.BorrowingId</dd>

        <dt class="col-sm-3">Book</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.Book?.Title ?? "-")</dd>

        <dt class="col-sm-3">Member</dt>
        <dd class="col-sm-9">@(Model.Borrowing?.User?.Name ?? "-")</dd>

        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

        <dt class="col-sm-3">Fine Date</dt>
        <dd class="col-sm-9">@Model.FineDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Reason</dt>
        <dd class="col-sm-9">@Model.Reason</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge bg-@(Model.Status == "Paid" ? "success" : Model.Status == "Unpaid" ? "danger" : "secondary")">
                @Model.Status
            </span>
        </dd>
    </dl>
</div>

<div class="mt-3">
    @if (User.IsInRole("Manager"))
    {
    <a asp-action="Edit" asp-route-id="@Model.FineId" class="btn btn-warning">Edit</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

