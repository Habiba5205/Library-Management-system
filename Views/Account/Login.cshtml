@model Lib_System.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="panel p-4">
            <h1 class="h3 mb-3">Sign in to your account</h1>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success toast">@successMessage</div>
            }

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="UsernameOrEmail" class="control-label"></label>
                    <input asp-for="UsernameOrEmail" class="form-control" placeholder="Enter username or email" autocomplete="username" />
                    <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign in<i data-lucide="arrow-right" aria-hidden="true"></i></button>
            </form>

            <div class="demo-access">
                <p class="demo-access-label">Quick demo access</p>
                <button type="button" class="demo-account" data-username="admin" data-password="Admin@123">
                    <span class="avatar">AS</span>
                    <span><strong>Admin - Admin Supervisor</strong><small>admin@library.local</small></span>
                </button>
                <button type="button" class="demo-account" data-username="manager" data-password="Manager@123">
                    <span class="avatar">LM</span>
                    <span><strong>Manager - Library Manager</strong><small>manager@library.local</small></span>
                </button>
                <button type="button" class="demo-account" data-username="member" data-password="Member@123">
                    <span class="avatar">LM</span>
                    <span><strong>Member - Library Member</strong><small>member@library.local</small></span>
                </button>
            </div>

            <div class="mt-3 text-center">
                <a asp-action="Register">Create a member account</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('.demo-account').forEach(button => {
            button.addEventListener('click', () => {
                const form = button.closest('.panel').querySelector('form');
                form.querySelector('[name="UsernameOrEmail"]').value = button.dataset.username;
                form.querySelector('[name="Password"]').value = button.dataset.password;
                form.querySelector('[name="Password"]').focus();
            });
        });
    </script>
}
